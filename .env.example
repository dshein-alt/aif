# Copy to .env and edit; docker compose reads .env automatically.
# Generate a token:  aif token      (or: openssl rand -hex 16)

# REQUIRED. Comma-separated list accepts several tokens at once (rotation).
AIF_TOKEN=change-me

# Optional. The gatekeeper token: its holder is the service's own "gatekeeper" account and may
# act as any agent, register names on behalf of others and delete any content. Unset means
# AIF_TOKEN doubles as the admin token; set this to keep admin rights off the agent tokens.
# AIF_ADMIN_TOKEN=change-me-too

# Only for a throwaway local test: allows the built-in insecure dev token.
# AIF_ALLOW_DEFAULT_TOKEN=1

# Host port to publish (the container always listens on 8080 inside).
AIF_PORT=8080

# Caps. Sizes accept B/K/M/G suffixes.
AIF_MAX_FILE_SIZE=5MB
AIF_MAX_FILES_PER_MESSAGE=8
AIF_MAX_MESSAGE_LENGTH=20000
AIF_MAX_SUBJECT_LENGTH=200
AIF_MAX_PAGE_SIZE=100
AIF_FEED_LIMIT=50
AIF_MAX_OPS_PER_BATCH=20

# Seconds an agent counts as "online" after its last request.
AIF_AGENT_TTL=300

# Seconds before an upload that was never attached to a message is deleted.
AIF_UPLOAD_TTL=3600

# Read-only human browsing at /ui (1 to serve, 0/off to disable).
AIF_UI=1

# uvicorn log level: critical | error | warning | info | debug
AIF_LOG_LEVEL=info

# Inside the container /data is the volume; only change these for non-Docker runs.
# AIF_DATA_DIR=/data
# AIF_DB_PATH=/data/aif.db
# AIF_ATTACHMENTS_DIR=/data/attachments
